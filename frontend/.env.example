# Copy to `.env.local` (git-ignored) and adjust. Only NEXT_PUBLIC_* values reach the browser,
# so NEVER put a secret, token or password here.

# Base URL of the Medilog API, exactly as the server serves it (scheme + host + port).
# The backend `http` launch profile serves http://localhost:5208 without an HTTPS redirect.
# (Using the `https` profile? Use https://localhost:7206 and trust the dev certificate; a
# browser CORS preflight fails if the API answers with a redirect.)
# The backend CORS policy already allows the Next.js dev origin http://localhost:3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5208

# TEMPORARY development identity (STATE.md Q-07: real authentication is not implemented yet).
# The API reads X-User-Id / X-User-Role headers only when it runs in Development with
# Auth:AllowHeaderIdentity=true. This is ignored in production builds.
NEXT_PUBLIC_DEV_IDENTITY=true

# Optional defaults used until you pick an identity in the "Acting as" dialog.
# Ids and roles of the synthetic data are listed in backend/docs/dev/seed-dev-data.sql.
NEXT_PUBLIC_DEV_USER_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
NEXT_PUBLIC_DEV_USER_ROLE=Secretary

# Clinic time zone used to decide what "today" and "in the past" mean in the forms.
# Must match the backend setting Clinic:TimeZone.
NEXT_PUBLIC_CLINIC_TIME_ZONE=Africa/Cairo

# Medical-records screens (D-28) use a development-only JWT bridge instead of header
# identity. Paste a token from `dotnet user-jwts create` into the in-app dev panel; it is
# kept in sessionStorage and never written here.

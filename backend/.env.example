# Reference template only. ASP.NET Core does not load .env automatically; set these through
# your shell, deployment platform, or `dotnet user-secrets`. Never commit populated values.

ConnectionStrings__DefaultConnection=
# Alternative database variable supported by the infrastructure:
MEDILOG_CONNECTION_STRING=

Jwt__SigningKey=

# Optional SMTP configuration. Keep Email__Enabled=false for the development .eml sink.
Email__Enabled=false
Email__Host=
Email__Port=587
Email__UseStartTls=true
Email__UserName=
Email__Password=
Email__FromAddress=no-reply@medilog.local
Email__FromName=Medilog

# Firebase project identifier is public, but keep deployment configuration centralized.
Firebase__ProjectId=

# Development only; never enable in production.
Seed__Enabled=false
Seed__Password=

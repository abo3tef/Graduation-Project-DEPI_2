{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "AllowHeaderIdentity": false
  },
  "Jwt": {
    "Issuer": "medilog",
    "Audience": "medilog-client",
    "AccessTokenMinutes": 1440
  },
  "Seed": {
    "Enabled": false
  },
  "Clinic": {
    "TimeZone": "Africa/Cairo"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}

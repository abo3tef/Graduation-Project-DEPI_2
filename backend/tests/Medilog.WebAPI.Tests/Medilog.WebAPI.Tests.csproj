<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Pin to the version Medilog.Infrastructure uses; the MySQL provider brings 10.0.12 transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Medilog.WebAPI\Medilog.WebAPI.csproj" />
    <ProjectReference Include="..\..\src\Medilog.Application\Medilog.Application.csproj" />
    <ProjectReference Include="..\..\src\Medilog.Domain\Medilog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the in-memory store/clock/scenario from the Application tests so the HTTP
         layer is tested against the same contract, with no database. -->
    <Compile Include="..\Medilog.Application.Tests\Support\Fakes.cs" Link="Support\Fakes.cs" />
    <Compile Include="..\Medilog.Application.Tests\Support\Scenario.cs" Link="Support\Scenario.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
